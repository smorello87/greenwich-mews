---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/url';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "Companion website for Brotherhood or the New Hell: The Greenwich Mews Theater, 1951–1973",
  image = "/images/og-image.jpg"
} = Astro.props;

const siteTitle = title === 'Greenwich Mews Theater'
  ? title
  : `${title} | Greenwich Mews Theater`;

// Social crawlers reject relative image paths, so resolve to an absolute URL.
const socialImage = new URL(withBase(image), Astro.site).href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <!-- Draft site: keep it out of search results and caches until it is ready to circulate. -->
    <meta name="robots" content="noindex, nofollow, noarchive" />

    <!-- Open Graph -->
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:type" content="website" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <title>{siteTitle}</title>
  </head>
  <body>
    <Navigation />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    <div class="draft-notice" role="note">
      <span class="draft-notice__stamp">Draft</span>
      <p class="draft-notice__text">
        Work in progress — not for circulation. Content, images, and rights clearances are still
        being checked.
      </p>
    </div>

    <script>
      // Scroll-triggered animations
      const observerOptions = {
        root: null,
        rootMargin: '0px 0px -10% 0px',
        threshold: 0.1
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      }, observerOptions);

      // Observe all elements with animation classes
      document.querySelectorAll('.fade-in, .fade-in-left, .fade-in-right').forEach(el => {
        observer.observe(el);
      });
    </script>
  </body>
</html>

<style is:global>
  #main-content {
    min-height: 100vh;
    padding-top: 80px; /* Account for fixed nav */
  }

  /* Clear the fixed draft notice so it never covers the end of the footer.
     Sized for the two-line wrap the notice takes on narrow viewports. */
  body {
    padding-bottom: 5rem;
  }
</style>

<style>
  .draft-notice {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 1100;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
    padding: 0.6rem var(--space-md);
    background: var(--color-espresso);
    border-top: 2px solid var(--color-rust);
    text-align: center;
  }

  .draft-notice__stamp {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-cream);
    border: 1px solid var(--color-rust);
    padding: 0.15em 0.6em;
    flex: none;
  }

  .draft-notice__text {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-sepia);
    margin: 0;
    max-width: 60ch;
  }

  @media (max-width: 600px) {
    .draft-notice {
      gap: 0.4rem;
      padding: 0.5rem var(--space-sm);
    }

    .draft-notice__text {
      font-size: 0.6875rem;
    }
  }

  @media print {
    .draft-notice {
      position: static;
    }
  }
</style>
