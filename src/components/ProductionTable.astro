---
import type { ProductionPayload } from '../lib/catalog';

interface Props {
  productions: ProductionPayload[];
  featuredIds: string[];
}

const { productions, featuredIds } = Astro.props;
const featured = new Set(featuredIds);

// Rendered columns are Season / Title / Playwright / Director, but search runs
// against everything in the record — cast, full credits, company, and notes
// included — so a designer or stage manager is findable from the table.
const searchText = (prod: ProductionPayload) =>
  [
    prod.year,
    prod.title,
    prod.company,
    prod.notes,
    ...prod.credits.map((c) => `${c.role} ${c.names}`),
    ...prod.cast,
  ]
    .join(' ')
    .toLowerCase();
---

<div class="table-wrapper">
  <div class="table-controls">
    <div class="table-search">
      <label for="production-search" class="visually-hidden">Search productions</label>
      <input
        type="search"
        id="production-search"
        class="table-search__input"
        placeholder="Search title, playwright, director, cast, designers..."
      />
      <svg class="table-search__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="M21 21l-4.35-4.35"></path>
      </svg>
    </div>

    <div class="table-count">
      <span id="result-count">{productions.length}</span> of {productions.length} productions
    </div>
  </div>

  <div class="table-scroll">
    <table class="productions-table" id="productions-table">
      <thead>
        <tr>
          <th class="sortable" data-sort="season">
            Season
            <span class="sort-icon">↕</span>
          </th>
          <th class="sortable" data-sort="title">
            Title
            <span class="sort-icon">↕</span>
          </th>
          <th class="sortable" data-sort="playwright">
            Playwright
            <span class="sort-icon">↕</span>
          </th>
          <th class="sortable" data-sort="director">
            Director
            <span class="sort-icon">↕</span>
          </th>
          <th><span class="visually-hidden">Details</span></th>
        </tr>
      </thead>
      <tbody>
        {productions.map((prod) => (
          <tr
            class:list={[{ featured: featured.has(prod.id) }]}
            data-production-id={prod.id}
            data-searchable={searchText(prod)}
          >
            <td class="cell-season" data-value={prod.year}>{prod.year}</td>
            <td class="cell-title" data-value={prod.title}>
              {prod.title}
              {featured.has(prod.id) && <span class="featured-badge" title="Featured production">★</span>}
            </td>
            <td class="cell-playwright" data-value={prod.playwright}>{prod.playwright}</td>
            <td class="cell-director" data-value={prod.director}>{prod.director}</td>
            <td class="cell-info">
              <button type="button" class="info-link" data-production-id={prod.id} aria-haspopup="dialog">
                Full Info
                <span class="visually-hidden"> for {prod.title} ({prod.year})</span>
              </button>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="table-empty" id="table-empty" hidden>No productions match that search.</p>

  <div class="table-legend">
    <span class="featured-badge">★</span> Featured productions have additional information in the timeline below
  </div>
</div>

<style>
  .table-wrapper {
    background: var(--color-cream);
    border: 1px solid var(--color-sepia);
  }

  .table-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-sm) var(--space-md);
    border-bottom: 1px solid var(--color-sepia);
    background: var(--color-parchment);
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .table-search {
    position: relative;
    flex: 1;
    max-width: 420px;
  }

  .table-search__input {
    width: 100%;
    padding: 0.75em 1em 0.75em 2.75em;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    border: 1px solid var(--color-sepia);
    background: var(--color-cream);
    color: var(--color-ink);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .table-search__input::placeholder {
    color: var(--color-tobacco);
    opacity: 0.7;
  }

  .table-search__input:focus {
    outline: none;
    border-color: var(--color-rust);
    box-shadow: 0 0 0 3px rgba(164, 90, 61, 0.1);
  }

  .table-search__icon {
    position: absolute;
    left: 0.875em;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-tobacco);
    pointer-events: none;
  }

  .table-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-tobacco);
    letter-spacing: 0.05em;
  }

  .table-scroll {
    overflow-x: auto;
  }

  .productions-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .productions-table th,
  .productions-table td {
    padding: 0.875em 1em;
    text-align: left;
    border-bottom: 1px solid var(--color-sepia);
  }

  .productions-table th {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-tobacco);
    background: var(--color-parchment);
    position: sticky;
    top: 0;
    white-space: nowrap;
  }

  .productions-table th.sortable {
    cursor: pointer;
    user-select: none;
    transition: color var(--transition-fast);
  }

  .productions-table th.sortable:hover {
    color: var(--color-espresso);
  }

  .sort-icon {
    margin-left: 0.5em;
    opacity: 0.4;
    transition: opacity var(--transition-fast);
  }

  .productions-table th.sortable:hover .sort-icon,
  .productions-table th.sorted .sort-icon {
    opacity: 1;
  }

  .productions-table th.sorted-asc .sort-icon::after {
    content: '↑';
  }

  .productions-table th.sorted-desc .sort-icon::after {
    content: '↓';
  }

  .productions-table tbody tr {
    transition: background var(--transition-fast);
  }

  .productions-table tbody tr:hover {
    background: var(--color-parchment);
  }

  .productions-table tbody tr.featured {
    background: rgba(184, 146, 58, 0.08);
  }

  .productions-table tbody tr.featured:hover {
    background: rgba(184, 146, 58, 0.15);
  }

  /* Scoped `display` rules above must not beat the hidden attribute. */
  .productions-table tbody tr[hidden] {
    display: none;
  }

  .cell-season {
    font-family: var(--font-mono);
    color: var(--color-faded-blue);
    white-space: nowrap;
  }

  .cell-title {
    font-weight: 600;
    color: var(--color-espresso);
  }

  .cell-info {
    text-align: right;
    white-space: nowrap;
  }

  .info-link {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-rust);
    background: none;
    border: 1px solid var(--color-sepia);
    padding: 0.5em 1em;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .info-link:hover,
  .info-link:focus-visible {
    background: var(--color-espresso);
    border-color: var(--color-espresso);
    color: var(--color-cream);
  }

  .featured-badge {
    display: inline-block;
    color: var(--color-aged-gold);
    margin-left: 0.5em;
    font-size: 0.875em;
  }

  .table-empty {
    padding: var(--space-md);
    text-align: center;
    font-style: italic;
    color: var(--color-tobacco);
    margin: 0;
  }

  .table-empty[hidden] {
    display: none;
  }

  .table-legend {
    padding: var(--space-sm) var(--space-md);
    border-top: 1px solid var(--color-sepia);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-tobacco);
    background: var(--color-parchment);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 768px) {
    .productions-table th,
    .productions-table td {
      padding: 0.625em 0.5em;
      font-size: 0.8125rem;
    }

    .cell-playwright,
    .cell-director,
    .productions-table th:nth-child(3),
    .productions-table th:nth-child(4) {
      display: none;
    }
  }
</style>

<script>
  const searchInput = document.getElementById('production-search') as HTMLInputElement;
  const table = document.getElementById('productions-table')!;
  const tbody = table.querySelector('tbody')!;
  const resultCount = document.getElementById('result-count')!;
  const emptyEl = document.getElementById('table-empty')!;
  const rows = Array.from(tbody.querySelectorAll<HTMLTableRowElement>('tr'));

  searchInput?.addEventListener('input', () => {
    const query = searchInput.value.toLowerCase().trim();
    let visible = 0;

    for (const row of rows) {
      const match = !query || (row.dataset.searchable ?? '').includes(query);
      row.hidden = !match;
      if (match) visible++;
    }

    resultCount.textContent = String(visible);
    emptyEl.hidden = visible > 0;
  });

  // Column index of each sortable header, so sorting reads the right cell.
  const SORT_COLUMN: Record<string, number> = {
    season: 0,
    title: 1,
    playwright: 2,
    director: 3,
  };

  const sortableHeaders = Array.from(table.querySelectorAll<HTMLElement>('th.sortable'));
  let currentSort = { column: '', direction: 'asc' as 'asc' | 'desc' };

  for (const header of sortableHeaders) {
    header.addEventListener('click', () => {
      const column = header.dataset.sort ?? '';
      if (!(column in SORT_COLUMN)) return;

      if (currentSort.column === column) {
        currentSort.direction = currentSort.direction === 'asc' ? 'desc' : 'asc';
      } else {
        currentSort = { column, direction: 'asc' };
      }

      for (const h of sortableHeaders) {
        h.classList.remove('sorted', 'sorted-asc', 'sorted-desc');
      }
      header.classList.add('sorted', `sorted-${currentSort.direction}`);

      const index = SORT_COLUMN[column];
      // data-value holds the bare field, without the featured star in the title.
      const value = (row: HTMLTableRowElement) =>
        row.cells[index]?.dataset.value ?? '';

      const sorted = [...rows].sort((a, b) => {
        const comparison =
          column === 'season'
            ? parseInt(value(a), 10) - parseInt(value(b), 10)
            : value(a).localeCompare(value(b));
        return currentSort.direction === 'asc' ? comparison : -comparison;
      });

      for (const row of sorted) tbody.appendChild(row);
    });
  }

  for (const button of table.querySelectorAll<HTMLElement>('.info-link')) {
    button.addEventListener('click', () => {
      const production = (window as any).productionsById?.[button.dataset.productionId!];
      if (production) window.openProductionModal(production);
    });
  }
</script>
