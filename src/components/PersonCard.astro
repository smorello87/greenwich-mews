---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Set for someone with a people.json profile; opens the person modal. */
  id?: string;
  /** Set instead for a name known only from the productions appendix;
      opens the contributor modal. Exactly one of the two is given. */
  contributorName?: string;
  name: string;
  role: string;
  years: string;
  thumbnail: ImageMetadata | null;
  documentCount: number;
  /** Label under the count — "document" for profiles, "production" for
      contributors, since that is what a click actually shows them. */
  countNoun?: string;
  actionLabel?: string;
}

const {
  id,
  contributorName,
  name,
  role,
  years,
  thumbnail,
  documentCount,
  countNoun = 'document',
  actionLabel = 'View Documents',
} = Astro.props;
---

<button
  class="person-card"
  data-person-id={id}
  data-contributor-name={contributorName}
  aria-haspopup="dialog"
>
  <div class="person-card__image-wrap">
    {thumbnail ? (
      <Image src={thumbnail} alt={name} class="person-card__image" width={480} height={480} loading="lazy" />
    ) : (
      <span class="empty-frame">No portrait yet</span>
    )}
    <div class="person-card__overlay">
      <span class="person-card__view">{actionLabel}</span>
    </div>
  </div>

  <div class="person-card__content">
    <h3 class="person-card__name">{name}</h3>
    <p class="person-card__role">{role}</p>
    <div class="person-card__meta">
      <span class="person-card__years">{years}</span>
      <span class="person-card__docs">{documentCount} {countNoun}{documentCount !== 1 ? 's' : ''}</span>
    </div>
  </div>

  <div class="person-card__corner" aria-hidden="true"></div>
</button>

<style>
  .person-card {
    display: block;
    width: 100%;
    background: var(--color-cream);
    border: none;
    padding: 0;
    text-align: left;
    cursor: pointer;
    position: relative;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .person-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid var(--color-sepia);
    pointer-events: none;
    transition: border-color var(--transition-fast);
  }

  .person-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 30px rgba(0,0,0,0.12);
  }

  .person-card:hover::before {
    border-color: var(--color-tobacco);
  }

  .person-card:focus {
    outline: none;
  }

  .person-card:focus-visible {
    outline: 2px solid var(--color-rust);
    outline-offset: 4px;
  }

  .person-card__image-wrap {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--color-parchment);
  }

  .person-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: sepia(20%) contrast(1.05);
    transition: transform var(--transition-slow), filter var(--transition-fast);
  }

  .person-card:hover .person-card__image {
    transform: scale(1.05);
    filter: sepia(0%) contrast(1.1);
  }

  .person-card__overlay {
    position: absolute;
    inset: 0;
    background: rgba(61, 43, 31, 0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--transition-fast);
  }

  .person-card:hover .person-card__overlay {
    opacity: 1;
  }

  .person-card__view {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-cream);
    padding: 0.75em 1.5em;
    border: 1px solid var(--color-cream);
    transition: background var(--transition-fast), color var(--transition-fast);
  }

  .person-card:hover .person-card__view {
    background: var(--color-cream);
    color: var(--color-espresso);
  }

  .person-card__content {
    padding: var(--space-sm);
  }

  .person-card__name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-espresso);
    margin-bottom: 0.25em;
  }

  .person-card__role {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-style: italic;
    color: var(--color-tobacco);
    margin-bottom: 0.75em;
  }

  .person-card__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-faded-blue);
  }

  .person-card__corner {
    position: absolute;
    top: 0;
    right: 0;
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 0 24px 24px 0;
    border-color: transparent var(--color-parchment) transparent transparent;
    transition: border-color var(--transition-fast);
  }

  .person-card:hover .person-card__corner {
    border-color: transparent var(--color-sepia) transparent transparent;
  }
</style>
