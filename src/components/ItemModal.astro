---
// Shared detail modal for archival items. Populated via JS:
// window.openItemModal(itemPayload) — see src/lib/catalog.ts for the shape.
---

<div class="modal-backdrop item-modal-backdrop" id="item-modal-backdrop" aria-hidden="true">
  <div class="modal item-modal" id="item-modal" role="dialog" aria-modal="true" aria-labelledby="item-modal-title">
    <button class="modal__close" id="item-modal-close" aria-label="Close item details">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="item-modal__content">
      <figure class="item-modal__figure">
        <img src="" alt="" id="item-modal-image" />
        <span class="empty-frame item-modal__empty" id="item-modal-empty" hidden>No scan yet</span>
      </figure>

      <div class="item-modal__meta">
        <ul class="item-modal__tags" id="item-modal-tags" aria-label="Tags"></ul>
        <h2 class="item-modal__title" id="item-modal-title"></h2>
        <span class="item-modal__date annotation" id="item-modal-date"></span>
        <p class="item-modal__caption" id="item-modal-caption"></p>

        <dl class="item-modal__details">
          <div class="item-modal__detail">
            <dt>Figure</dt>
            <dd id="item-modal-fig"></dd>
          </div>
          <div class="item-modal__detail" id="item-modal-creator-row" hidden>
            <dt>Photographer</dt>
            <dd id="item-modal-creator"></dd>
          </div>
          <div class="item-modal__detail">
            <dt>Source</dt>
            <dd id="item-modal-source"></dd>
          </div>
          <div class="item-modal__detail">
            <dt>Rights</dt>
            <dd id="item-modal-rights"></dd>
          </div>
          <div class="item-modal__detail" id="item-modal-people-row" hidden>
            <dt>Related People</dt>
            <dd id="item-modal-people"></dd>
          </div>
          <div class="item-modal__detail" id="item-modal-contributors-row" hidden>
            <dt>Also in the Catalog</dt>
            <dd id="item-modal-contributors"></dd>
          </div>
          <div class="item-modal__detail" id="item-modal-productions-row" hidden>
            <dt>Related Productions</dt>
            <dd id="item-modal-productions"></dd>
          </div>
        </dl>

        <div class="item-modal__needs" id="item-modal-needs-row" hidden>
          <h3 class="item-modal__needs-heading">Still needed for this record</h3>
          <ul class="item-modal__needs-list" id="item-modal-needs"></ul>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .item-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 2100; /* above the person modal so it can stack on top */
    background: rgba(26, 20, 16, 0.9);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-md);
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--transition-medium), visibility var(--transition-medium);
    overflow-y: auto;
  }

  .item-modal-backdrop.open {
    opacity: 1;
    visibility: visible;
  }

  .item-modal {
    position: relative;
    width: 100%;
    max-width: 1000px;
    max-height: 90vh;
    background: var(--color-cream);
    overflow-y: auto;
    transform: translateY(20px) scale(0.98);
    transition: transform var(--transition-medium);
  }

  .item-modal-backdrop.open .item-modal {
    transform: translateY(0) scale(1);
  }

  .item-modal::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--color-aged-gold), var(--color-rust));
  }

  .modal__close {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-cream);
    border: 1px solid var(--color-sepia);
    color: var(--color-tobacco);
    cursor: pointer;
    transition: all var(--transition-fast);
    z-index: 10;
  }

  .modal__close:hover {
    background: var(--color-espresso);
    border-color: var(--color-espresso);
    color: var(--color-cream);
  }

  .item-modal__content {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: var(--space-md);
    padding: var(--space-lg);
  }

  .item-modal__figure {
    margin: 0;
    background: var(--color-parchment);
    padding: 8px;
    border: 1px solid var(--color-sepia);
    align-self: start;
  }

  .item-modal__figure img {
    display: block;
    width: 100%;
    height: auto;
    filter: sepia(10%);
  }

  /* What this record is still missing, so a gap in the catalog is visible
     on the page rather than only in the spreadsheet. */
  .item-modal__needs {
    margin-top: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    border-left: 3px solid var(--color-rust);
    background: var(--color-parchment);
  }

  .item-modal__needs[hidden] { display: none; }

  .item-modal__needs-heading {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-rust);
    margin: 0 0 0.5em;
  }

  .item-modal__needs-list {
    margin: 0;
    padding-left: 1.1em;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.7;
    color: var(--color-espresso);
  }

  .item-modal__empty { min-height: 240px; font-size: 0.75rem; }

  .item-modal__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    list-style: none;
    margin: 0 0 var(--space-sm);
    padding: 0;
  }

  :global(.tag-chip) {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-tobacco);
    border: 1px solid var(--color-sepia);
    background: var(--color-parchment);
    padding: 0.25em 0.75em;
  }

  .item-modal__title {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    margin-bottom: 0.25em;
  }

  .item-modal__date {
    display: block;
    margin-bottom: var(--space-sm);
  }

  .item-modal__caption {
    font-size: 1.0625rem;
    line-height: 1.8;
    margin-bottom: var(--space-md);
  }

  .item-modal__details {
    border-top: 1px solid var(--color-sepia);
    margin: 0;
  }

  .item-modal__detail[hidden] {
    display: none;
  }

  .item-modal__detail {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: var(--space-sm);
    padding: var(--space-xs) 0;
    border-bottom: 1px solid var(--color-parchment);
  }

  .item-modal__detail dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-tobacco);
    padding-top: 0.35em;
  }

  .item-modal__detail dd {
    margin: 0;
    font-size: 0.9375rem;
    /* Credit lines carry long unbroken URLs; without this they push the
       modal wider than the viewport and force a horizontal scrollbar. */
    overflow-wrap: anywhere;
  }

  .item-modal__detail dd a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 700px) {
    .item-modal__content {
      grid-template-columns: 1fr;
      padding: var(--space-md);
    }

    .item-modal__detail {
      grid-template-columns: 1fr;
      gap: 0.25em;
    }
  }
</style>

<script>
  import { createModalController } from '../scripts/modal-controller';
  import { withBase } from '../lib/url';

  const backdrop = document.getElementById('item-modal-backdrop')!;
  const modal = document.getElementById('item-modal')!;
  const closeBtn = document.getElementById('item-modal-close')!;
  const controller = createModalController(backdrop, modal);

  closeBtn.addEventListener('click', () => controller.close());

  function fillLinks(rowId: string, cellId: string, entries: { href: string; label: string }[]) {
    const row = document.getElementById(rowId)!;
    const cell = document.getElementById(cellId)!;
    cell.textContent = '';
    row.hidden = entries.length === 0;
    entries.forEach((entry, i) => {
      if (i > 0) cell.appendChild(document.createTextNode(', '));
      const a = document.createElement('a');
      a.href = entry.href;
      a.textContent = entry.label;
      cell.appendChild(a);
    });
  }

  window.openItemModal = function (item: any) {
    const image = document.getElementById('item-modal-image') as HTMLImageElement;
    const empty = document.getElementById('item-modal-empty')!;
    // No scan for this row yet: hide the <img> and show an empty frame, rather
    // than leaving a broken image behind.
    if (item.fullSrc) {
      image.src = item.fullSrc;
      image.alt = item.title;
      image.hidden = false;
      empty.hidden = true;
    } else {
      image.removeAttribute('src');
      image.alt = '';
      image.hidden = true;
      empty.hidden = false;
    }

    document.getElementById('item-modal-title')!.textContent = item.title;
    document.getElementById('item-modal-date')!.textContent = item.date || 'Date not recorded';
    document.getElementById('item-modal-caption')!.textContent = item.caption;
    document.getElementById('item-modal-fig')!.textContent = item.figId;
    document.getElementById('item-modal-source')!.textContent =
      item.source || 'Not yet recorded';
    document.getElementById('item-modal-rights')!.textContent =
      item.rights || 'Not yet recorded';

    const creatorRow = document.getElementById('item-modal-creator-row')!;
    creatorRow.hidden = !item.creator;
    if (item.creator) {
      document.getElementById('item-modal-creator')!.textContent = item.creator;
    }

    const needsRow = document.getElementById('item-modal-needs-row')!;
    const needsList = document.getElementById('item-modal-needs')!;
    needsList.textContent = '';
    needsRow.hidden = item.needs.length === 0;
    for (const need of item.needs) {
      const li = document.createElement('li');
      li.textContent = need;
      needsList.appendChild(li);
    }

    const tags = document.getElementById('item-modal-tags')!;
    tags.textContent = '';
    for (const tag of item.tags) {
      const li = document.createElement('li');
      li.className = 'tag-chip';
      li.textContent = tag.label;
      tags.appendChild(li);
    }

    fillLinks(
      'item-modal-people-row',
      'item-modal-people',
      item.people.map((p: any) => ({ href: withBase('/people'), label: p.name }))
    );
    // Names with no profile of their own, but which the productions appendix
    // knows. Clicking opens the contributor modal, which lists every
    // production they worked on. Guarded because that modal is only mounted on
    // pages that carry the contributor payload.
    const contribRow = document.getElementById('item-modal-contributors-row')!;
    const contribCell = document.getElementById('item-modal-contributors')!;
    contribCell.textContent = '';
    contribRow.hidden = item.contributors.length === 0;
    item.contributors.forEach((name: string, i: number) => {
      if (i > 0) contribCell.appendChild(document.createTextNode(', '));
      const lookup = (window as any).productionContributors?.[name];
      if (lookup && typeof (window as any).openContributorModal === 'function') {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'name-link';
        btn.textContent = name;
        btn.addEventListener('click', () => (window as any).openContributorModal(lookup));
        contribCell.appendChild(btn);
      } else {
        contribCell.appendChild(document.createTextNode(name));
      }
    });

    fillLinks(
      'item-modal-productions-row',
      'item-modal-productions',
      item.productions.map((p: any) => ({ href: withBase('/productions'), label: `${p.title} (${p.year})` }))
    );

    controller.open(closeBtn as HTMLElement);
  };
</script>
