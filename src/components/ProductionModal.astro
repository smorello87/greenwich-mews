---
// Full-credit detail overlay for a production. Populated via JS:
// window.openProductionModal(payload) — see getProductionPayloads in src/lib/catalog.ts.
---

<div class="modal-backdrop production-modal-backdrop" id="production-modal-backdrop" aria-hidden="true">
  <div
    class="modal production-modal"
    id="production-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="production-modal-title"
  >
    <button class="modal__close" id="production-modal-close" aria-label="Close production details">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="production-modal__content">
      <header class="production-modal__header">
        <span class="production-modal__season annotation" id="production-modal-season"></span>
        <h2 class="production-modal__title" id="production-modal-title"></h2>
        <p class="production-modal__company" id="production-modal-company"></p>
        <p class="production-modal__notes" id="production-modal-notes" hidden></p>
      </header>

      <dl class="production-modal__credits" id="production-modal-credits"></dl>

      <section class="production-modal__cast" id="production-modal-cast-section" hidden>
        <h3 class="production-modal__subhead">Cast</h3>
        <ul class="production-modal__cast-list" id="production-modal-cast"></ul>
      </section>

      <p class="production-modal__hint" id="production-modal-hint" hidden>
        Underlined names worked on more than one production — select one to see the rest.
      </p>
    </div>
  </div>
</div>

<style>
  .production-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 2000;
    background: rgba(26, 20, 16, 0.9);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-md);
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--transition-medium), visibility var(--transition-medium);
    overflow-y: auto;
  }

  .production-modal-backdrop.open {
    opacity: 1;
    visibility: visible;
  }

  .production-modal {
    position: relative;
    width: 100%;
    max-width: 760px;
    max-height: 90vh;
    background: var(--color-cream);
    overflow-y: auto;
    transform: translateY(20px) scale(0.98);
    transition: transform var(--transition-medium);
  }

  .production-modal-backdrop.open .production-modal {
    transform: translateY(0) scale(1);
  }

  .production-modal::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--color-aged-gold), var(--color-rust));
  }

  .modal__close {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-cream);
    border: 1px solid var(--color-sepia);
    color: var(--color-tobacco);
    cursor: pointer;
    transition: all var(--transition-fast);
    z-index: 10;
  }

  .modal__close:hover {
    background: var(--color-espresso);
    border-color: var(--color-espresso);
    color: var(--color-cream);
  }

  .production-modal__content {
    padding: var(--space-lg);
  }

  .production-modal__header {
    padding-right: 3rem;
    margin-bottom: var(--space-md);
  }

  .production-modal__season {
    display: block;
    color: var(--color-faded-blue);
  }

  .production-modal__title {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    margin: 0.15em 0 0.35em;
  }

  .production-modal__company {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-tobacco);
    margin: 0;
  }

  .production-modal__notes {
    font-style: italic;
    color: var(--color-tobacco);
    margin: var(--space-xs) 0 0;
  }

  .production-modal__notes[hidden] {
    display: none;
  }

  .production-modal__credits {
    border-top: 1px solid var(--color-sepia);
    margin: 0;
  }

  /* Credit rows are built in JS, so they never carry Astro's scope attribute —
     these rules have to be global to reach them. */
  :global(.production-modal__credit) {
    display: grid;
    grid-template-columns: 190px 1fr;
    gap: var(--space-sm);
    padding: var(--space-xs) 0;
    border-bottom: 1px solid var(--color-parchment);
  }

  :global(.production-modal__credit dt) {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-tobacco);
    padding-top: 0.35em;
    margin: 0;
  }

  :global(.production-modal__credit dd) {
    margin: 0;
    font-size: 0.9375rem;
  }

  .production-modal__cast {
    margin-top: var(--space-md);
  }

  .production-modal__cast[hidden] {
    display: none;
  }

  .production-modal__subhead {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-tobacco);
    margin-bottom: var(--space-xs);
  }

  .production-modal__cast-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.15em var(--space-md);
    font-size: 0.9375rem;
  }

  .production-modal__hint {
    margin: var(--space-md) 0 0;
    padding-top: var(--space-xs);
    border-top: 1px solid var(--color-parchment);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
    color: var(--color-tobacco);
  }

  .production-modal__hint[hidden] {
    display: none;
  }

  /* Name buttons are built in JS, so they never carry the scope attribute. */
  :global(.name-link) {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    color: inherit;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-sepia);
  }

  :global(.name-link:hover),
  :global(.name-link:focus-visible) {
    color: var(--color-rust);
    text-decoration-style: solid;
    text-decoration-color: currentColor;
  }

  @media (max-width: 700px) {
    .production-modal__content {
      padding: var(--space-md);
    }

    :global(.production-modal__credit) {
      grid-template-columns: 1fr;
      gap: 0.25em;
    }
  }
</style>

<script>
  import { createModalController } from '../scripts/modal-controller';

  const backdrop = document.getElementById('production-modal-backdrop')!;
  const modal = document.getElementById('production-modal')!;
  const closeBtn = document.getElementById('production-modal-close')!;
  const controller = createModalController(backdrop, modal);

  closeBtn.addEventListener('click', () => controller.close());

  // Mirrors NAME_SEPARATOR in src/lib/catalog.ts, but keeps the separators as
  // capture groups so a credit renders exactly as printed with only the names
  // swapped for buttons.
  const NAME_SPLIT = /(,\s*(?![^(]*\))|\s+in association with\s+)/i;

  let linkedAnyName = false;

  /** Write `value` into `target`, linking each name with more work to show. */
  function renderNames(target: HTMLElement, value: string) {
    const contributors = (window as any).productionContributors ?? {};
    target.textContent = '';
    value.split(NAME_SPLIT).forEach((part, index) => {
      if (index % 2 === 1) {
        target.appendChild(document.createTextNode(part)); // a separator
        return;
      }
      const contributor = contributors[part.trim()];
      if (!contributor) {
        target.appendChild(document.createTextNode(part));
        return;
      }
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'name-link';
      button.textContent = part;
      button.title = `${contributor.appearances.length} productions`;
      button.addEventListener('click', () => window.openContributorModal(contributor));
      target.appendChild(button);
      linkedAnyName = true;
    });
  }

  window.openProductionModal = function (production: any) {
    linkedAnyName = false;
    document.getElementById('production-modal-season')!.textContent = String(production.year);
    document.getElementById('production-modal-title')!.textContent = production.title;
    document.getElementById('production-modal-company')!.textContent = production.company;

    const notes = document.getElementById('production-modal-notes')!;
    notes.textContent = production.notes;
    notes.hidden = !production.notes;

    const credits = document.getElementById('production-modal-credits')!;
    credits.textContent = '';
    for (const credit of production.credits) {
      const row = document.createElement('div');
      row.className = 'production-modal__credit';
      const dt = document.createElement('dt');
      dt.textContent = credit.role;
      const dd = document.createElement('dd');
      renderNames(dd, credit.names);
      row.append(dt, dd);
      credits.appendChild(row);
    }

    const castSection = document.getElementById('production-modal-cast-section')!;
    const castList = document.getElementById('production-modal-cast')!;
    castList.textContent = '';
    castSection.hidden = production.cast.length === 0;
    for (const name of production.cast) {
      const li = document.createElement('li');
      renderNames(li, name);
      castList.appendChild(li);
    }

    document.getElementById('production-modal-hint')!.hidden = !linkedAnyName;

    // Reopening while already open means the contributor modal sent us to a
    // different production — repopulate in place instead of stacking a copy.
    if (!backdrop.classList.contains('open')) {
      controller.open(closeBtn as HTMLElement);
    } else {
      modal.scrollTop = 0;
      (closeBtn as HTMLElement).focus();
    }
  };
</script>
