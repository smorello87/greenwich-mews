---
// One architectural sheet, shown as a card you can turn over. The versos of
// the Municipal Archives plans carry the Department of Buildings approval
// stamps rather than a drawing, so front and back are both worth seeing.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  title: string;
  front: ImageMetadata;
  back: ImageMetadata;
  frontAlt: string;
  backAlt: string;
  caption: string;
  backCaption: string;
}

const { id, title, front, back, frontAlt, backAlt, caption, backCaption } = Astro.props;
---

<figure class="plan" data-plan={id}>
  <div class="plan__viewport">
    <div class="plan__inner" data-flipped="false">
      <div class="plan__face plan__face--front">
        <Image src={front} alt={frontAlt} widths={[500, 900, 1400]} sizes="(max-width: 900px) 100vw, 460px" loading="lazy" />
      </div>
      <div class="plan__face plan__face--back" aria-hidden="true">
        <Image src={back} alt={backAlt} widths={[500, 900]} sizes="(max-width: 900px) 100vw, 460px" loading="lazy" />
      </div>
    </div>
  </div>

  <figcaption class="plan__caption">
    <h3 class="plan__title">{title}</h3>
    <p class="plan__text" data-face="front">{caption}</p>
    <p class="plan__text" data-face="back" hidden>{backCaption}</p>
    <button type="button" class="plan__toggle" aria-pressed="false">
      <span class="plan__toggle-icon" aria-hidden="true">⟲</span>
      <span class="plan__toggle-label">Turn over</span>
    </button>
  </figcaption>
</figure>

<style>
  .plan {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .plan__viewport {
    perspective: 1800px;
  }

  .plan__inner {
    position: relative;
    transform-style: preserve-3d;
    transition: transform 0.75s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .plan__inner[data-flipped='true'] {
    transform: rotateY(180deg);
  }

  .plan__face {
    background: var(--color-parchment);
    padding: 8px;
    border: 1px solid var(--color-sepia);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  /* The front stays in flow so it sets the card's height; the back is laid
     over it, pre-rotated so it reads correctly once the card turns. */
  .plan__face--front {
    position: relative;
  }

  .plan__face--back {
    position: absolute;
    inset: 0;
    transform: rotateY(180deg);
  }

  .plan__face :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .plan__title {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    margin: 0 0 0.25em;
  }

  .plan__text {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.7;
    color: var(--color-tobacco);
    margin: 0 0 var(--space-xs);
  }

  .plan__text[hidden] {
    display: none;
  }

  .plan__toggle {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    background: none;
    border: 1px solid var(--color-sepia);
    padding: 0.4em 0.9em;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-tobacco);
    cursor: pointer;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .plan__toggle:hover,
  .plan__toggle:focus-visible {
    color: var(--color-rust);
    border-color: var(--color-rust);
  }

  .plan__toggle-icon {
    font-size: 0.9rem;
    line-height: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .plan__inner {
      transition: none;
    }
  }
</style>

<script>
  for (const plan of document.querySelectorAll<HTMLElement>('.plan')) {
    const inner = plan.querySelector<HTMLElement>('.plan__inner')!;
    const toggle = plan.querySelector<HTMLButtonElement>('.plan__toggle')!;
    const label = plan.querySelector<HTMLElement>('.plan__toggle-label')!;
    const front = plan.querySelector<HTMLElement>('.plan__face--front')!;
    const back = plan.querySelector<HTMLElement>('.plan__face--back')!;
    const frontText = plan.querySelector<HTMLElement>('[data-face="front"]')!;
    const backText = plan.querySelector<HTMLElement>('[data-face="back"]')!;

    toggle.addEventListener('click', () => {
      const flipped = inner.dataset.flipped !== 'true';
      inner.dataset.flipped = String(flipped);
      toggle.setAttribute('aria-pressed', String(flipped));
      label.textContent = flipped ? 'Turn back' : 'Turn over';
      frontText.hidden = flipped;
      backText.hidden = !flipped;
      // Keep the hidden face out of the accessibility tree, so a screen reader
      // only ever meets the side that is actually facing the reader.
      front.setAttribute('aria-hidden', String(flipped));
      back.setAttribute('aria-hidden', String(!flipped));
    });
  }
</script>
